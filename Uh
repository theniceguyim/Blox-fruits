--------------------------------------------------
-- LOADING BAR LOGIC
--------------------------------------------------
local loading = false
local progress = 0
local firewallActive = false

local TOTAL_TIME = 120
local TARGET = 0.99

local function startLoadingBar()
	loading = true
	barFill.Size = UDim2.new(0, 0, 1, 0)

	local stepInterval = 0.6
	local totalSteps = TOTAL_TIME / stepInterval

	task.spawn(function()
		for i = 1, totalSteps do
			if not loading then break end
			local chunk = math.random(1, 2) / 100
			progress = math.clamp(progress + chunk, 0, TARGET)

			TweenService:Create(
				barFill,
				TweenInfo.new(stepInterval, Enum.EasingStyle.Linear),
				{ Size = UDim2.new(progress, 0, 1, 0) }
			):Play()

			if progress >= TARGET and not firewallActive then
				firewallActive = true
				firewallLabel.Visible = true
				dontLeaveLabel.Visible = true
			end

			task.wait(stepInterval)
		end
	end)

	task.spawn(function()
		local dots = 0
		while loading do
			local dotStr = string.rep(".", dots)
			subtitle.Text = "Bypassing Anti-cheat" .. dotStr
			if firewallActive then
				firewallLabel.Text = "Firewall detected" .. dotStr
				dontLeaveLabel.Text = "Don't leave while bypassing" .. dotStr
			end
			dots = (dots + 1) % 4
			task.wait(0.6)
		end
	end)
end

--------------------------------------------------
-- FIX BLURRY EFFECT BY DISABLING DEPTH OF FIELD
--------------------------------------------------
local function disableBlurEffects()
	-- Disable DepthOfField effect
	if Lighting:FindFirstChildOfClass("DepthOfFieldEffect") then
		Lighting:FindFirstChildOfClass("DepthOfFieldEffect").Enabled = false
	end
	
	-- Disable any other blur effects
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") then
			effect.Enabled = false
		end
	end
	
	-- Also check Camera for effects
	if Camera:FindFirstChildOfClass("DepthOfFieldEffect") then
		Camera:FindFirstChildOfClass("DepthOfFieldEffect").Enabled = false
	end
end

