local WHITELIST = {
	["LoadingScreenUI"] = true,
	["PolishedForgeGUI"] = true
}

local existing = {}

local function snapshot(container)
	for _, g in ipairs(container:GetChildren()) do
		if g:IsA("ScreenGui") then
			existing[g] = true
		end
	end
end

snapshot(CoreGui)
snapshot(PlayerGui)

local function shouldRemove(guiObj)
	if not guiObj:IsA("ScreenGui") then return false end
	if WHITELIST[guiObj.Name] then return false end
	if existing[guiObj] then return false end
	return true
end

local function monitor(container)
	container.ChildAdded:Connect(function(child)
		task.wait()
		if shouldRemove(child) then
			pcall(function() child:Destroy() end)
		end
	end)
end

monitor(CoreGui)
monitor(PlayerGui)

--------------------------------------------------
-- HIDE SPECIFIC USERS FULLY (CHARACTER + NAME TAG + ITEMS + CHAT)
-- WITH REAL-TIME UPDATES FOR EQUIPMENT CHANGES AND EFFECTS LIKE HAKI
--------------------------------------------------
local HIDDEN_USERS = {
    ["thenicebroim"] = true,
    ["helper_b4o"] = true
}

-- Track hidden characters and their connections
local hiddenCharacterConnections = {}

local function applyHiddenEffectsToDescendant(v)
    if v:IsA("BasePart") then
        v.LocalTransparencyModifier = 1
        -- Also hide any particle effects attached to parts
        for _, effect in ipairs(v:GetChildren()) do
            if effect:IsA("ParticleEmitter") or effect:IsA("Beam") or effect:IsA("Trail") then
                effect.Enabled = false
            end
        end
    elseif v:IsA("Accessory") and v:FindFirstChild("Handle") then
        v.Handle.LocalTransparencyModifier = 1
        -- Hide accessory particles
        for _, effect in ipairs(v.Handle:GetChildren()) do
            if effect:IsA("ParticleEmitter") or effect:IsA("Beam") or effect:IsA("Trail") then
                effect.Enabled = false
            end
        end
    elseif v:IsA("Tool") and v:FindFirstChild("Handle") then
        v.Handle.LocalTransparencyModifier = 1
        -- Hide tool particles
        for _, effect in ipairs(v.Handle:GetChildren()) do
            if effect:IsA("ParticleEmitter") or effect:IsA("Beam") or effect:IsA("Trail") then
                effect.Enabled = false
            end
        end
    elseif v:IsA("BillboardGui") then
        v.Enabled = false -- hides name tags + chat above head
    elseif v:IsA("TextLabel") or v:IsA("TextBox") then
        v.TextTransparency = 1
        v.TextStrokeTransparency = 1
    elseif v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
        -- Direct particle effects (like Haki aura)
        v.Enabled = false
    elseif v:IsA("SurfaceGui") or v:IsA("Decal") then
        -- Hide decals and surface GUIs
        v.Transparency = 1
    elseif v:IsA("SpecialMesh") or v:IsA("MeshPart") then
        -- For mesh-based effects
        v.VertexColor = Vector3.new(1, 1, 1)
        if v:IsA("MeshPart") then
            v.LocalTransparencyModifier = 1
        end
    end
end

local function hideEverything(char)
    if not char then return end
    
    -- Clear any existing connections for this character
    if hiddenCharacterConnections[char] then
        for _, conn in ipairs(hiddenCharacterConnections[char]) do
            conn:Disconnect()
        end
        hiddenCharacterConnections[char] = nil
    end
    
    hiddenCharacterConnections[char] = {}
    
    -- Apply to existing descendants (including Haki effects)
    for _, v in ipairs(char:GetDescendants()) do
        applyHiddenEffectsToDescendant(v)
    end
    
    -- Listen for new descendants (equipment changes, Haki effects, etc.)
    local descendantConnection = char.DescendantAdded:Connect(function(v)
        task.wait(0.05) -- Shorter wait for immediate effect
        applyHiddenEffectsToDescendant(v)
        
        -- Also apply to any children of this new descendant immediately
        for _, child in ipairs(v:GetDescendants()) do
            applyHiddenEffectsToDescendant(child)
        end
    end)
    
    table.insert(hiddenCharacterConnections[char], descendantConnection)
    
    -- Also monitor for property changes (like Transparency changes)
    local propertyConnection = RunService.Heartbeat:Connect(function()
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                if v.LocalTransparencyModifier < 1 then
                    v.LocalTransparencyModifier = 1
                end
            elseif v:IsA("ParticleEmitter") or v:IsA("Beam") or v:IsA("Trail") then
                if v.Enabled then
                    v.Enabled = false
                end
            end
        end
    end)
    
    table.insert(hiddenCharacterConnections[char], propertyConnection)
    
    -- Also listen for character removal to clean up
    local characterRemovedConnection = char.AncestryChanged:Connect(function(_, parent)
        if parent == nil then
            if hiddenCharacterConnections[char] then
                for _, conn in ipairs(hiddenCharacterConnections[char]) do
                    conn:Disconnect()
                end
                hiddenCharacterConnections[char] = nil
            end
        end
    end)
    
    table.insert(hiddenCharacterConnections[char], characterRemovedConnection)
end

local function enforceHiddenUser(plr)
    if HIDDEN_USERS[plr.Name] then
        if plr.Character then
            hideEverything(plr.Character)
        end
        plr.CharacterAdded:Connect(function(char)
            task.wait(0.5) -- Wait a bit longer for character to fully load
            hideEverything(char)
        end)
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
    enforceHiddenUser(plr)
end
Players.PlayerAdded:Connect(enforceHiddenUser)

