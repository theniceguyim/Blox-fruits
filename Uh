-- THIRD PERSON FREEZE
--------------------------------------------------
local CAMERA_DISTANCE = 8
local CAMERA_HEIGHT = 3
local clone = nil
local originalCharacter = nil

local function freezeVisuals()
	disableBlurEffects() -- Fix blurry effect
	
	originalCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local success, errorMsg = pcall(function()
		originalCharacter.Archivable = true
	end)
	
	if not success then
		warn("Could not archive character: " .. tostring(errorMsg))
		return
	end
	
	clone = originalCharacter:Clone()
	clone.Name = "VisualClone"
	clone.Parent = workspace

	for _, v in ipairs(clone:GetDescendants()) do
		if v:IsA("BasePart") then
			v.Anchored = true
			v.CanCollide = false
		elseif v:IsA("Motor6D") then
			v.Enabled = false
		end
	end

	if clone:FindFirstChild("HumanoidRootPart") then
		clone.HumanoidRootPart.CFrame = originalCharacter.HumanoidRootPart.CFrame
	else
		clone:Destroy()
		warn("No HumanoidRootPart found in clone")
		return
	end
	
	-- DON'T disable chat icon - only hide chat bubbles
	-- StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false) -- REMOVED THIS LINE
	
	-- Connect camera update
	local cameraConnection = RunService.RenderStepped:Connect(function()
		if clone and clone.Parent and clone:FindFirstChild("HumanoidRootPart") then
			local look = clone.HumanoidRootPart.CFrame.LookVector
			local pos = clone.HumanoidRootPart.Position - look * CAMERA_DISTANCE + Vector3.new(0, CAMERA_HEIGHT, 0)
			Camera.CFrame = CFrame.lookAt(pos, clone.HumanoidRootPart.Position + Vector3.new(0, CAMERA_HEIGHT, 0))
		end
	end)
	
	return cameraConnection
end

